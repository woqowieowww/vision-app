<Window x:Class="KursProjDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Упражнения для зрения" Width="1000" Height="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TextBlock Text="Выберите упражнение" FontSize="24" FontWeight="Bold" Margin="20" HorizontalAlignment="Center" />
        <ListBox 
            x:Name="ExercisesList" 
            ItemsSource="{Binding}"
            Margin="20,60,20,100"
            Background="#FFEEEEEE"
            BorderBrush="#FFCCCCCC"
            AlternationCount="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel LastChildFill="False">
                        <TextBlock 
                            Text="{Binding Name}" 
                            FontSize="24"
                            FontWeight="Medium" 
                            Foreground="#FF333333"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left">
                            <TextBlock.ToolTip>
                                <Border Background="White" Padding="10" CornerRadius="5" BorderThickness="1" BorderBrush="#FFCCCCCC">
                                    <StackPanel>
                                        <TextBlock 
                                            Text="{Binding Description}" 
                                            FontSize="14" 
                                            Foreground="#FF333333" 
                                            TextWrapping="Wrap" 
                                            Margin="0,5,0,10"/>
                                        <TextBlock 
                                            Text="{Binding Duration, StringFormat='Длительность: {0} сек.'}" 
                                            FontSize="14" 
                                            Foreground="#FF666666"/>
                                    </StackPanel>
                                </Border>
                            </TextBlock.ToolTip>
                        </TextBlock>
                        <TextBlock 
                            FontSize="16"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="Text" Value="Не выполнено ✖"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="Foreground" Value="Green"/>
                                            <Setter Property="Text" Value="Выполнено ✔"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Margin" Value="0,5"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <StackPanel 
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,5">
            <Button 
                Content="Начать" 
                Width="180" Height="60"
                Margin="20"
                Click="StartExercise_Click"/>
            <Button 
                Content="Выполнено" 
                Width="180" Height="60"
                Margin="20"
                Click="MarkAsDone_Click"/>
            <Button 
                Content="История" 
                Width="180" Height="60"
                Margin="20"
                Click="ShowHistory_Click"/>
            <Button 
                Content="О программе" 
                Width="180" Height="60"
                Margin="20"
                Click="ShowHelp_Click"/>
        </StackPanel>
    </Grid>
</Window>