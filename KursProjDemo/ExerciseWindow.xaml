<Window x:Class="KursProjDemo.ExerciseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выполнение упражнения" Width="810" Height="600"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#FFF5F5F5">
        <Border 
            Background="White" 
            CornerRadius="10"
            Margin="0,0,240,0"
            Height="505"
            Width="505">
            <Image 
                x:Name="ExerciseImage"
                Stretch="Uniform"
                Margin="0"/>
        </Border>
        <TextBlock 
            x:Name="ExerciseDescription"
            Width="245" Height="310"
            HorizontalAlignment="Right"
            TextWrapping="Wrap"
            FontSize="16"
            Foreground="#FF333333"
            Margin="0,20,0,300"/>
        <Border 
            Width="170" 
            Height="170"
            Background="#FF0078D4"
            CornerRadius="100"
            HorizontalAlignment="Right"
            Margin="0,300,50,60">
            <TextBlock 
                x:Name="TimerText"
                Text="00:00"
                FontSize="48"
                Foreground="White"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
        </Border>
        <Button 
            x:Name="MarkAsDoneButton"
            Content="Выполнено"
            Width="120"
            Height="40"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,75,20"
            Click="MarkAsDoneButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#FF0078D4" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border 
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    BorderThickness="1"
                                    BorderBrush="#FF0078D4">
                                    <ContentPresenter 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>