<Window x:Class="KursProjDemo.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История выполнения" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5">
    <Grid Margin="20">
        <TextBlock 
            Text="История выполнения упражнений" 
            FontSize="24" 
            FontWeight="Bold" 
            HorizontalAlignment="Center" 
            Margin="0,0,0,20" />
        <DataGrid 
            x:Name="HistoryDataGrid" 
            AutoGenerateColumns="False" 
            IsReadOnly="True" 
            AlternatingRowBackground="#FFF0F0F0" 
            AlternationCount="2"
            Margin="0,0,0,60">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование методики" Binding="{Binding MethodName}" Width="*" />
                <DataGridTextColumn Header="Дата выполнения" Binding="{Binding CompletionDate}" Width="*" />
                <DataGridTextColumn Header="Статус выполнения" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <Button 
            Content="Закрыть" 
            Width="100" 
            Height="40" 
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,0"
            Click="CloseButton_Click"/>
    </Grid>
</Window>