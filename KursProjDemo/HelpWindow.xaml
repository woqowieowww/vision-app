<Window x:Class="KursProjDemo.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка" Width="800" Height="600" 
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5">
    <Grid>
        <TextBlock 
            Text="О программе" 
            FontSize="20" 
            FontWeight="Bold" 
            Foreground="#FF333333"
            Margin="20,10,20,10"
            HorizontalAlignment="Center"/>
        <ScrollViewer 
            VerticalScrollBarVisibility="Auto" 
            Margin="20,60,20,60">
            <TextBlock 
                x:Name="HelpTextBlock" 
                TextWrapping="Wrap" 
                FontSize="14" 
                Foreground="#FF333333"
                Margin="0,0,0,20"/>
        </ScrollViewer>
    </Grid>
</Window>